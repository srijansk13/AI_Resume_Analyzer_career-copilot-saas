# MongoDB Connection String
MONGODB_URI="your_mongodb_connection_string_here"

# Gemini AI API Key (Single Primary Key)
GEMINI_API_KEY="your_primary_gemini_api_key_here"

# Multiple Gemini API Keys for Automatic Rate Limit / Quota Failover Rotation
# Provide a comma-separated list of keys without spaces. If configured, these take priority.
GEMINI_API_KEYS="key_1_here,key_2_here,key_3_here"

# JWT Secret for Authentication
JWT_SECRET="your_jwt_secret_here"

# Email Configuration (SMTP)
SMTP_HOST="smtp.your_provider.com"
SMTP_PORT="587"
SMTP_USER="your_email_user@example.com"
SMTP_PASS="your_email_password_here"
EMAIL_FROM="your_email_user@example.com"

# Gemini models override waterfall (comma-separated, backward compatible)
GEMINI_MODELS=gemini-2.5-flash
GEMINI_KEY_COOLDOWN_MS=90000

